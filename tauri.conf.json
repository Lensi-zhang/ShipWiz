{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShipWiz",
  "version": "0.2.2",
  "identifier": "com.shipwiz.desktop",
  "mainBinaryName": "shipwiz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./src-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShipWiz",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "轻量航海风 Docker 桌面与命令行客户端",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
