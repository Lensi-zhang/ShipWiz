{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShipWiz",
  "version": "0.1.0",
  "identifier": "com.shipwiz.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./src-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShipWiz",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
