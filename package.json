{
  "name": "shipwiz",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "scripts": {
    "dev": "vite src-frontend",
    "build": "vue-tsc -p src-frontend/tsconfig.json --noEmit && vite build src-frontend",
    "lint": "eslint src-frontend eslint.config.js vitest.config.ts scripts/*.mjs",
    "format": "prettier --write src-frontend eslint.config.js vitest.config.ts scripts/*.mjs package.json tauri.conf.json .github/workflows/ci.yml .github/workflows/release.yml",
    "format:check": "prettier --check src-frontend eslint.config.js vitest.config.ts scripts/*.mjs package.json tauri.conf.json .github/workflows/ci.yml .github/workflows/release.yml",
    "test": "vitest run",
    "test:updater": "node --test scripts/normalize-updater.test.mjs",
    "bump": "node scripts/version.mjs bump",
    "postbump": "prettier --write package.json package-lock.json npm/package.json tauri.conf.json",
    "check:version": "node scripts/version.mjs check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.8.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
